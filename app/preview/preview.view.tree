$realworld_app_preview $realworld_app_el
	class_names \article-preview
	article null
	sub /
		<= Meta $realworld_app_el
			class_names \article-meta
			sub /
				<= Author_pic $realworld_app_link
					arg *
						page \profile
						user <= author \
					sub /
						<= Avatar $realworld_app_image
							uri <= author_image \
							alt <= author
				<= Info $realworld_app_el
					class_names \info
					sub /
						<= Author_link $realworld_app_link
							class_base \author
							arg *
								page \profile
								user <= author
							sub /
								<= author
						<= Date $realworld_app_el
							dom_name \span
							class_names \date
							sub /
								<= date \
				<= Favorite $realworld_app_button
					class_names <= favorite_class \btn btn-outline-primary btn-sm pull-xs-right
					click? <=> favorite? null
					sub /
						<= Favorite_icon $realworld_app_el
							dom_name \i
							class_names \ion-heart
						<= favorites_count \
		<= Link $realworld_app_link
			class_base \preview-link
			arg *
				page \article
				slug <= slug \
			sub /
				<= Title $realworld_app_el
					dom_name \h1
					sub /
						<= title \
				<= Description $realworld_app_el
					dom_name \p
					sub /
						<= description \
				<= More $realworld_app_el
					dom_name \span
					sub /
						\Read more...
				<= Tags $realworld_app_el
					dom_name \ul
					class_names \tag-list
					sub <= tag_pills /
	Tag* $realworld_app_el
		dom_name \li
		class_names \tag-default tag-pill tag-outline
		sub /
			<= tag_name* \
