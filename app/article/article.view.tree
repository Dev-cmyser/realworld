$realworld_app_article $realworld_app_el
	class_names \article-page
	slug \
	sub /
		<= Banner $realworld_app_el
			class_names \banner
			sub /
				<= Banner_container $realworld_app_el
					class_names \container
					sub /
						<= Title $realworld_app_el
							dom_name \h1
							sub /
								<= title \
						<= Meta_top $realworld_app_article_meta
							article <= article null
		<= Container $realworld_app_el
			class_names \container page
			sub /
				<= Content_row $realworld_app_el
					class_names \row article-content
					sub /
						<= Content_column $realworld_app_el
							class_names \col-md-12
							sub /
								<= Body $realworld_app_article_body
									text <= body \
								<= Tags $realworld_app_el
									dom_name \ul
									class_names \tag-list
									sub <= tag_pills /
				<= Divider $realworld_app_el
					dom_name \hr
				<= Actions $realworld_app_el
					class_names \article-actions
					sub /
						<= Meta_bottom $realworld_app_article_meta
							article <= article
				<= Comments_row $realworld_app_el
					class_names \row
					sub /
						<= Comments_column $realworld_app_el
							class_names \col-xs-12 col-md-8 offset-md-2
							sub /
								<= Errors $realworld_app_el
									dom_name \ul
									class_names \error-messages
									sub <= error_rows /
								<= Comments $realworld_app_el
									sub <= comment_box /
	Tag* $realworld_app_el
		dom_name \li
		class_names \tag-default tag-pill tag-outline
		sub /
			<= tag_name* \
	Error* $realworld_app_el
		dom_name \li
		sub /
			<= error_text* \
	Comment* $realworld_app_comment
		comment <= comment* null
		slug <= slug
		errors? <=> errors? /
		dropped? <=> comment_dropped? null
	Form $realworld_app_form
		class_names \card comment-form
		submit? <=> post? null
		sub /
			<= Comment_block $realworld_app_el
				class_names \card-block
				sub /
					<= Comment_text $realworld_app_area
						class_names \form-control
						name \comment
						rows \3
						hint \Write a comment...
						value? <=> comment_text? \
			<= Form_foot $realworld_app_el
				class_names \card-footer
				sub /
					<= Comment_avatar $realworld_app_image
						class_names \comment-author-img
						uri <= user_image \
					<= Post $realworld_app_button
						class_names \btn btn-sm btn-primary
						type \submit
						sub /
							\Post Comment
	Guest_note $realworld_app_el
		dom_name \p
		sub /
			<= Signin_link $realworld_app_link
				arg *
					page \login
				sub /
					\Sign in
			\ or
			<= Signup_link $realworld_app_link
				arg *
					page \register
				sub /
					\sign up
			\ to add comments on this article.
