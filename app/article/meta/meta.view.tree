$realworld_app_article_meta $realworld_app_el
	class_names \article-meta
	article null
	sub /
		<= Author_pic $realworld_app_link
			arg *
				page \profile
				user <= author \
			sub /
				<= Avatar $realworld_app_image
					uri <= author_image \
					alt <= author
		<= Info $realworld_app_el
			class_names \info
			sub /
				<= Author_link $realworld_app_link
					class_base \author
					arg *
						page \profile
						user <= author
					sub /
						<= author
				<= Date $realworld_app_el
					dom_name \span
					class_names \date
					sub /
						<= date \
		<= Actions $realworld_app_el
			sub <= actions /
	Edit $realworld_app_link
		class_base \btn btn-sm btn-outline-secondary
		arg *
			page \editor
			slug <= slug \
		sub /
			<= Edit_icon $realworld_app_el
				dom_name \i
				class_names \ion-edit
			\ Edit Article
	Delete $realworld_app_button
		class_names \btn btn-sm btn-outline-danger
		click? <=> delete? null
		sub /
			<= Delete_icon $realworld_app_el
				dom_name \i
				class_names \ion-trash-a
			\ Delete Article
	Follow $realworld_app_button
		class_names \btn btn-sm btn-outline-secondary
		click? <=> follow? null
		sub /
			<= Follow_icon $realworld_app_el
				dom_name \i
				class_names \ion-plus-round
			<= follow_title \
	Favorite $realworld_app_button
		class_names <= favorite_class \btn btn-sm btn-outline-primary
		click? <=> favorite? null
		sub /
			<= Favorite_icon $realworld_app_el
				dom_name \i
				class_names \ion-heart
			<= favorite_title \
			<= Counter $realworld_app_el
				dom_name \span
				class_names \counter
				sub /
					<= favorites_count \
