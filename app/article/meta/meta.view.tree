$realworld_app_article_meta $mol_view
	article null
	dark false
	attr *
		^
		realworld_dark <= dark
	sub /
		<= Author_pic $realworld_app_link
			arg *
				page \profile
				user <= author \
			sub /
				<= Avatar $mol_image
					uri <= author_image \
					title <= author
		<= Info $mol_view
			sub /
				<= Author_link $realworld_app_link
					arg *
						page \profile
						user <= author
					sub /
						<= author
				<= Date $mol_view
					sub /
						<= date \
		<= Actions $mol_view
			sub <= actions /
	Edit $realworld_app_link
		arg *
			page \editor
			slug <= slug \
		sub /
			<= Edit_icon $mol_icon_edit
			\ Edit Article
	Delete $realworld_app_button
		click? <=> delete? null
		sub /
			<= Delete_icon $mol_icon_trash_can
			\ Delete Article
	Follow $realworld_app_button
		click? <=> follow? null
		title <= follow_title \
		active <= following false
	Favorite $realworld_app_button
		click? <=> favorite? null
		active <= favorited false
		sub /
			<= Favorite_icon $mol_icon_heart
			<= favorite_title \
