$realworld_app_editor $realworld_app_el
	class_names \editor-page
	sub /
		<= Container $realworld_app_el
			class_names \container page
			sub /
				<= Row $realworld_app_el
					class_names \row
					sub /
						<= Column $realworld_app_el
							class_names \col-md-10 offset-md-1 col-xs-12
							sub /
								<= Errors $realworld_app_el
									dom_name \ul
									class_names \error-messages
									sub <= error_rows /
								<= Form $realworld_app_form
									submit? <=> submit? null
									sub /
										<= Fields $realworld_app_el
											dom_name \fieldset
											sub /
												<= Head_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Head $realworld_app_input
															class_names \form-control form-control-lg
															name \title
															hint \Article Title
															value? <=> form_title? \
												<= About_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= About $realworld_app_input
															name \description
															hint \What's this article about?
															value? <=> form_about? \
												<= Body_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Body $realworld_app_area
															name \body
															hint \Write your article (in markdown)
															value? <=> form_body? \
												<= Tag_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Tag_field $realworld_app_editor_tags
															hint \Enter tags
															value? <=> tag_draft? \
															enter? <=> tag_add? null
														<= Tags $realworld_app_el
															class_names \tag-list
															sub <= tag_pills /
												<= Publish $realworld_app_button
													class_names \btn btn-lg pull-xs-right btn-primary
													type \submit
													sub /
														<= submit_title \
	Tag* $realworld_app_el
		dom_name \span
		class_names \tag-default tag-pill
		sub /
			<= Tag_remove* $realworld_app_el
				dom_name \i
				class_names \ion-close-round
				event *
					^
					click? <=> tag_remove*? null
			<= tag_name* \
	Error* $realworld_app_el
		dom_name \li
		sub /
			<= error_text* \
