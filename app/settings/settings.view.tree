$realworld_app_settings $realworld_app_el
	class_names \settings-page
	sub /
		<= Container $realworld_app_el
			class_names \container page
			sub /
				<= Row $realworld_app_el
					class_names \row
					sub /
						<= Column $realworld_app_el
							class_names \col-md-6 offset-md-3 col-xs-12
							sub /
								<= Title $realworld_app_el
									dom_name \h1
									class_names \text-xs-center
									sub /
										\Your Settings
								<= Errors $realworld_app_el
									dom_name \ul
									class_names \error-messages
									sub <= error_rows /
								<= Form $realworld_app_form
									submit? <=> submit? null
									sub /
										<= Fields $realworld_app_el
											dom_name \fieldset
											sub /
												<= Image_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Image $realworld_app_input
															name \image
															hint \URL of profile picture
															value? <=> image? \
												<= Username_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Username $realworld_app_input
															class_names \form-control form-control-lg
															name \username
															hint \Your Name
															value? <=> username? \
												<= Bio_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Bio $realworld_app_area
															class_names \form-control form-control-lg
															name \bio
															hint \Short bio about you
															value? <=> bio? \
												<= Email_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Email $realworld_app_input
															class_names \form-control form-control-lg
															name \email
															hint \Email
															value? <=> email? \
												<= Password_group $realworld_app_el
													dom_name \fieldset
													class_names \form-group
													sub /
														<= Password $realworld_app_input
															class_names \form-control form-control-lg
															name \password
															type \password
															hint \New Password
															value? <=> password? \
												<= Submit $realworld_app_button
													class_names \btn btn-lg btn-primary pull-xs-right
													type \submit
													sub /
														\Update Settings
								<= Divider $realworld_app_el
									dom_name \hr
								<= Logout $realworld_app_button
									class_names \btn btn-outline-danger
									click? <=> logout? null
									sub /
										\Or click here to logout.
	Error* $realworld_app_el
		dom_name \li
		sub /
			<= error_text* \
