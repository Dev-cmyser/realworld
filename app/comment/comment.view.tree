$realworld_app_comment $realworld_app_el
	class_names \card
	comment null
	slug \
	errors? /
	sub /
		<= Body $realworld_app_el
			class_names \card-block
			sub /
				<= Text $realworld_app_el
					dom_name \p
					class_names \card-text
					sub /
						<= body \
		<= Foot $realworld_app_el
			class_names \card-footer
			sub /
				<= Author_pic $realworld_app_link
					class_base \comment-author
					arg *
						page \profile
						user <= author \
					sub /
						<= Avatar $realworld_app_image
							class_names \comment-author-img
							uri <= author_image \
							alt <= author
				<= Author_link $realworld_app_link
					class_base \comment-author
					arg *
						page \profile
						user <= author
					sub /
						<= author
				<= Date $realworld_app_el
					dom_name \span
					class_names \date-posted
					sub /
						<= date \
				<= Actions $realworld_app_el
					dom_name \span
					class_names \mod-options
					sub <= actions /
	Delete $realworld_app_el
		dom_name \i
		class_names \ion-trash-a
		event *
			^
			click? <=> delete? null
