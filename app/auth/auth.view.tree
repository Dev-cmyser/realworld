$realworld_app_auth $realworld_app_el
	class_names \auth-page
	sub /
		<= Container $realworld_app_el
			class_names \container page
			sub /
				<= Row $realworld_app_el
					class_names \row
					sub /
						<= Column $realworld_app_el
							class_names \col-md-6 offset-md-3 col-xs-12
							sub /
								<= Title $realworld_app_el
									dom_name \h1
									class_names \text-xs-center
									sub /
										<= title \
								<= Switch_note $realworld_app_el
									dom_name \p
									class_names \text-xs-center
									sub /
										<= Switch $realworld_app_link
											arg <= switch_arg *
											sub /
												<= switch_title \
								<= Errors $realworld_app_el
									dom_name \ul
									class_names \error-messages
									sub <= error_rows /
								<= Form $realworld_app_form
									submit? <=> submit? null
									sub /
										<= Fields $realworld_app_el
											sub <= fields /
										<= Submit $realworld_app_button
											class_names \btn btn-lg btn-primary pull-xs-right
											type \submit
											sub /
												<= title
	Username_group $realworld_app_el
		dom_name \fieldset
		class_names \form-group
		sub /
			<= Username $realworld_app_input
				class_names \form-control form-control-lg
				name \username
				hint \Username
				value? <=> username? \
	Email_group $realworld_app_el
		dom_name \fieldset
		class_names \form-group
		sub /
			<= Email $realworld_app_input
				class_names \form-control form-control-lg
				name \email
				hint \Email
				value? <=> email? \
	Password_group $realworld_app_el
		dom_name \fieldset
		class_names \form-group
		sub /
			<= Password $realworld_app_input
				class_names \form-control form-control-lg
				name \password
				type \password
				hint \Password
				value? <=> password? \
	Error* $realworld_app_el
		dom_name \li
		sub /
			<= error_text* \
